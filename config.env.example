# Required
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional overrides
WORKLOG_DIR=~/worklog
WORKLOG_AGENT_CONFIG=~/.config/worklog-agent/config.env
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TIMEOUT_SECONDS=300

# Vertex AI (use company GCP quota instead of free-tier personal quota)
# Requires: gcloud auth application-default login
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
MAX_AGENT_STEPS=6
TOOL_TIMEOUT_SECONDS=180
QUEUE_POLL_INTERVAL_SECONDS=2

# Heartbeat (periodic check-ins)
HEARTBEAT_ENABLED=true
HEARTBEAT_EVERY_SECONDS=1800
HEARTBEAT_LIGHT_CONTEXT=true
HEARTBEAT_ACTIVE_HOURS_START=08:00
HEARTBEAT_ACTIVE_HOURS_END=23:00
HEARTBEAT_ACTIVE_HOURS_TZ=America/Los_Angeles

# Cron (scheduled jobs)
CRON_ENABLED=true

# Context compaction (summarize old conversation history)
COMPACTION_ENABLED=true
COMPACTION_MAX_SESSION_MESSAGES=40
COMPACTION_KEEP_RECENT=12
COMPACTION_MAX_CONTEXT_CHARS=80000
